#include <stdio.h>

int main() {
    int units;
    float bill;

    scanf("%d", &units);

    if (units < 0) {
        printf("Invalid units");
    } else if (units <= 200) {
        bill = units * 0.50;
        printf("Rs.%.2f", bill);
    } else if (units <= 400) {
        bill = units * 0.65 + 100;
        printf("Rs.%.2f", bill);
    } else if (units <= 600) {
        bill = units * 0.80 + 200;
        printf("Rs.%.2f", bill);
    } else {
        bill = units * 1.25 + 425;
        printf("Rs.%.2f", bill);
    }

    return 0;
}
