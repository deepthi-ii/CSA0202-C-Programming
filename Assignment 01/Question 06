#include <stdio.h>

int main() {
    int a, b, c, cars;

    scanf("%d", &a);
    scanf("%d", &b);
    scanf("%d", &c);
    scanf("%d", &cars);

    if (cars <= 0) {
        printf("No path exists");
    } else if (a % cars == 0) {
        printf("Car 1 goes into road A");
    } else if (b % cars == 0) {
        printf("Car 1 goes into road B");
    } else if (c % cars == 0) {
        printf("Car 1 goes into road C");
    } else {
        printf("No path exists");
    }

    return 0;
}
